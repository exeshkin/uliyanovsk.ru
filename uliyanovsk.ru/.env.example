# SMTP настройки для PHPMailer
# Скопируйте этот файл в .env и заполните реальными значениями
# Файл .env НЕ должен коммититься в репозиторий!

# SMTP сервер
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_SECURE=tls

# Учётные данные
SMTP_USERNAME=anir.u@yandex.ru
SMTP_PASSWORD=ваш_пароль_приложения

# От кого
MAIL_FROM=anir.u@yandex.ru
MAIL_FROM_NAME="Сайт Общение Христиан"

# Получатель заявок
MAIL_TO=anir.u@yandex.ru

# Секретный ключ для проверки формы
SECRET_KEY=BIGSecret
